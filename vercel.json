{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "redirects": [
    {
      "source": "/blog/:path*",
      "has": [{ "type": "host", "value": "umutsatir.dev" }],
      "destination": "https://blog.umutsatir.dev/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
