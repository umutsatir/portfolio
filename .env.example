# Server-side only (Vercel Functions). Never prefix with VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# the "Secret key" (sb_secret_...) from Project Settings → API Keys; the legacy service_role JWT also works
SUPABASE_SERVICE_ROLE_KEY=
# Optional: mainnet RPC used to look up ENS names (public default is used if empty)
MAINNET_RPC_URL=

# Public (shipped to the browser via envPrefix in vite.config.ts): WalletConnect project id from https://dashboard.reown.com (free).
# Without it the "WalletConnect" option is simply hidden.
WALLETCONNECT_PROJECT_ID=
